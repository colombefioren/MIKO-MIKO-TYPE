{
  "name": "miko-miko-type",
  "version": "2.0.0",
  "private": true,
  "description": "Miko-Miko Type: a social typing test with friends, chat and live leaderboards, built with vanilla JavaScript and Supabase.",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 5500 --bind 127.0.0.1",
    "test": "node --test \"tests/**/*.test.js\"",
    "db:start": "npx --yes supabase@2.121.0 start",
    "db:stop": "npx --yes supabase@2.121.0 stop",
    "db:reset": "npx --yes supabase@2.121.0 db reset",
    "db:import-legacy": "scripts/import-legacy.sh"
  },
  "keywords": [
    "typing",
    "game",
    "speedtyping"
  ],
  "author": "Colombe Fioren & Mihaja",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  }
}
